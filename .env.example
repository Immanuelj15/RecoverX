# Database Configuration
MONGODB_URI=mongodb://localhost:27017/recoverx
MONGODB_URI_TEST=mongodb://localhost:27017/recoverx_test

# Backend Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Groq LLM Provider Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=10000
MAX_LLM_RETRIES=3

# Financial Guardrails & Policy Configuration
MIN_RECOVERY_PROBABILITY=0.70
MAX_RETRY_COUNT=3
HIGH_VALUE_THRESHOLD_PAISE=5000000

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
